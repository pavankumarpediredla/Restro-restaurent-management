# Build from repository root: docker build -f backend/Dockerfile.notification-service .
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY notification-service/pom.xml notification-service/pom.xml
RUN mvn -f notification-service/pom.xml -B dependency:go-offline
COPY notification-service/src notification-service/src
RUN mvn -f notification-service/pom.xml -B -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
RUN addgroup --system restro && adduser --system --ingroup restro restro
COPY --from=build /workspace/notification-service/target/notification-service-*.jar app.jar
USER restro
EXPOSE 8082
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
