# Copy this file to backend/.env locally. Never commit the real .env file.
DB_URL=jdbc:mysql://restro-rpm-projects.g.aivencloud.com:14662/defaultdb?sslMode=REQUIRED
DB_USERNAME=avnadmin
DB_PASSWORD=replace-with-your-aiven-password
RESTRO_BOOTSTRAP_ADMIN_USERNAME=owner
RESTRO_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
RESTRO_BOOTSTRAP_ADMIN_NAME=Restaurant Owner
# Notification delivery requires a Kafka-compatible broker. Leave blank only if
# you do not need notification-service event consumption yet.
KAFKA_BOOTSTRAP_SERVERS=
